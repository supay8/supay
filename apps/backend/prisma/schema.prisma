// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SiatEnvironment {
  PILOTO
  PRODUCCION
}

// PENDING: lista para enviar, ya tiene CUFD asignado
// SENT: enviada al SIN, esperando respuesta (evita reenvíos duplicados si el proceso se cae)
// ACCEPTED: validada y aceptada por el SIN
// REJECTED: rechazada por el SIN (errores de validación)
// OFFLINE: emitida mientras el SIN no respondía; pendiente de sincronizar dentro del evento de contingencia
// CANCELLED: anulada (requiere motivoAnulacion)
enum InvoiceStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  OFFLINE
  CANCELLED
}

enum DocumentType {
  CI
  CEX
  PAS
  NIT
  OD
}

// Modalidad bajo la que se emitió la factura. Va en el XML (tipoEmision / CodigoDocumentoSector)
enum EmissionType {
  EN_LINEA      // Todo normal: se generó y se envió al SIN en el momento
  OFFLINE       // El sistema/internet local falló: se generó localmente y se sincroniza después
  CONTINGENCIA  // El SIN mismo estaba caído: requiere un ContingencyEvent reportado
}

// Catálogo oficial de motivos de contingencia del SIN (Anexo técnico)
enum ContingencyReason {
  FALTA_ENERGIA_ELECTRICA
  FALLA_CONEXION_INTERNET
  FALLA_SERVIDOR_SIN        // El sitio del SIN no responde (esto es lo que quieres cubrir)
  FALLA_SISTEMA_FACTURACION
  OTRO
}

model Company {
  id             String   @id @default(cuid())
  nit            String   @unique
  businessName   String
  codigoSistema  String
  ambiente       SiatEnvironment @default(PILOTO)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pointsOfSale   PointOfSale[]
  customers      Customer[]
  invoices       Invoice[]
}

// Cada caja/punto de emisión declarado ante el SIN.
// codigoSucursal queda con default 0 (Casa Matriz) hasta que necesites sucursales reales.
model PointOfSale {
  id                String   @id @default(cuid())
  companyId         String

  codigoSucursal    Int      @default(0)
  codigoPuntoVenta  Int
  description       String

  // El CUIS pertenece al punto de venta, no a la empresa global
  cuis              String?
  cuisCreatedAt     DateTime?

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  company           Company @relation(fields: [companyId], references: [id])
  cufds             Cufd[]
  invoices          Invoice[]
  contingencyEvents ContingencyEvent[]

  @@unique([companyId, codigoSucursal, codigoPuntoVenta])
}

model Cufd {
  id               String   @id @default(cuid())
  pointOfSaleId    String
  cufd             String
  direccion        String
  codigoControl    String
  validFrom        DateTime
  validTo          DateTime

  pointOfSale      PointOfSale @relation(fields: [pointOfSaleId], references: [id])
  invoices         Invoice[]

  @@index([pointOfSaleId, validFrom])
}

// Evento de contingencia: se abre cuando el SIN (o el internet/energía local) se cae,
// y se cierra cuando vuelve el servicio. El "codigoRecepcion" que devuelve el SIN
// al reportar el evento es lo que luego va adjunto a cada factura offline al sincronizar.
model ContingencyEvent {
  id                  String    @id @default(cuid())
  pointOfSaleId       String

  reason              ContingencyReason
  description         String?

  startDate           DateTime
  endDate             DateTime?

  // Código que el SIN devuelve al reportar el evento (una vez que vuelve la conexión).
  // Null mientras el evento sigue abierto / aún no se pudo reportar.
  siatEventCode       String?

  // true una vez que todas las facturas OFFLINE de este evento fueron enviadas al SIN
  isSynced            Boolean   @default(false)

  createdAt           DateTime  @default(now())

  pointOfSale         PointOfSale @relation(fields: [pointOfSaleId], references: [id])
  invoices            Invoice[]

  @@index([pointOfSaleId, startDate])
}

model Customer {
  id                String   @id @default(cuid())
  companyId         String
  documentType      DocumentType
  documentNumber    String
  complement        String?
  name              String
  company           Company @relation(fields: [companyId], references: [id])
  invoices          Invoice[]
  @@unique([companyId, documentType, documentNumber])
}

model Invoice {
  id                    String   @id @default(cuid())

  companyId             String
  customerId            String
  pointOfSaleId         String
  cufdId                String
  contingencyEventId    String?  // solo si emissionType != EN_LINEA

  invoiceNumber         Int
  cuf                   String? @unique

  emissionType          EmissionType @default(EN_LINEA)

  // --- Campos obligatorios en el XML del SIN, aunque uses valores por defecto ---
  codigoMetodoPago      Int      @default(1)               // 1 = Efectivo, 2 = Tarjeta, etc.
  codigoMoneda          Int      @default(1)                // 1 = Boliviano
  tipoCambio            Decimal  @default(1) @db.Decimal(18,5)

  issueDate             DateTime
  subtotal              Decimal @db.Decimal(18,2)
  discount              Decimal @default(0) @db.Decimal(18,2)
  total                 Decimal @db.Decimal(18,2)
  xml                   String?
  xmlHash               String?
  siatReceptionCode     String?
  status                InvoiceStatus @default(PENDING)

  // --- Anulación: el SIN exige motivo (1-4) para generar el evento de anulación ---
  motivoAnulacion       Int?
  fechaAnulacion        DateTime?

  createdAt             DateTime @default(now())

  company               Company @relation(fields: [companyId], references: [id])
  customer              Customer @relation(fields: [customerId], references: [id])
  pointOfSale           PointOfSale @relation(fields: [pointOfSaleId], references: [id])
  cufdRecord            Cufd @relation(fields: [cufdId], references: [id])
  contingencyEvent      ContingencyEvent? @relation(fields: [contingencyEventId], references: [id])

  items                 InvoiceItem[]
  events                InvoiceEvent[]

  @@unique([pointOfSaleId, invoiceNumber])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  code              String
  description       String
  codigoActividad   String?
  codigoProductoSin String?
  unitCode          Int?     // UnidadMedida del XML, ej: 58 = Unidad, 88 = Servicio
  quantity          Decimal @db.Decimal(18,3)
  unitPrice         Decimal @db.Decimal(18,2)
  discount          Decimal @default(0) @db.Decimal(18,2)
  subtotal          Decimal @db.Decimal(18,2)
  invoice           Invoice @relation(fields: [invoiceId], references: [id])
}

// Bitácora simple: qué se envió y qué respondió el SIN en cada intento
model InvoiceEvent {
  id                String   @id @default(cuid())
  invoiceId         String
  type              String
  message           String
  payload           Json?
  createdAt         DateTime @default(now())
  invoice           Invoice @relation(fields: [invoiceId], references: [id])
}