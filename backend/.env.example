# Supay Backend — variables de entorno de ejemplo.
# Copia este archivo a .env y completa los valores reales.

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/supay?sslmode=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Protege únicamente los endpoints /internal/* de bootstrap.
BACKEND_SECRET=cambiar-por-un-secreto-interno-largo-y-aleatorio

# Compatibilidad legacy. Las API keys por empresa se crean desde la API.
API_KEY=

# Auth del frontend self-hosted. No se usa en DEPLOYMENT_MODE=cloud.
# Genere con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=supay-selfhosted
JWT_ACCESS_TTL=24h

# Auth de Supay Cloud (Better Auth + plugin JWT/JWKS).
# BETTER_AUTH_URL debe ser exactamente el baseURL/issuer configurado en Next.js.
# BETTER_AUTH_URL=https://auth.supay.bo
# Opcionales; por defecto heredan BETTER_AUTH_URL y /api/auth/jwks.
# BETTER_AUTH_JWKS_URL=https://auth.supay.bo/api/auth/jwks
# BETTER_AUTH_ISSUER=https://auth.supay.bo
# BETTER_AUTH_AUDIENCE=https://auth.supay.bo
BETTER_AUTH_JWKS_CACHE_TTL=1h
BETTER_AUTH_HTTP_TIMEOUT=5s

# Puerto HTTP del servidor
PORT=8081
# Orígenes separados por coma. En cloud configure el dominio real de Next.js.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SIAT - Infra compartida (multi-tenant por CompanyId)
# Ambiente: 1 = producción, 2 = piloto (default infra, override por empresa/certificate)
SIAT_AMBIENTE=2
# Modalidad default: 1 = electrónica en línea, 2 = computarizada (override por empresa/certificate)
SIAT_MODALIDAD=1
SIAT_TRACE_ID=
# URL base opcional; se deduce del ambiente si se omite
# SIAT_BASE_URL=https://pilotosiatservicios.impuestos.gob.bo/v2
# Código del sistema proveedor autorizado por el SIN. Es global para toda la
# plataforma Supay; no pertenece a cada tenant.
SIAT_CODIGO_SISTEMA=
# Timeout de llamadas SOAP al SIAT
SIAT_TIMEOUT=45s

# Cifrado AES-GCM para credenciales por empresa (requerido en producción multi-tenant)
# Genere con: openssl rand -base64 32
ENCRYPTION_KEY=cambiar-por-clave-base64-de-32-bytes-min-16
# Alias legacy: MASTER_ENCRYPTION_KEY / SIAT_ENCRYPTION_KEY

# DEPRECATED - credenciales globales SIAT (mono-tenant). Configure el token
# delegado por tenant mediante PATCH /companies/{id}; certificates recibe solo P12.
# SIAT_NIT=
# SIAT_TOKEN_DELEGADO=
# SIAT_CERT_P12=firma_digital/firma.p12
# SIAT_CERT_P12_PASSWORD=
# SIAT_CERT_PEM_CERT=firma_digital/firma-cert.pem
# Sandbox fiscal determinista. Debe habilitarse solo en tests/desarrollo
# controlado; cuando es false, credenciales faltantes producen un error claro.
SIAT_SANDBOX=false
# SIAT_CERT_PEM_KEY=firma_digital/firma-key.pem

# Deployment — selfhosted (default) vs cloud (infra administrada)
# selfhosted = BYO infra, con salida a internet para SIAT SOAP. cloud = R2 + DB gestionada.
DEPLOYMENT_MODE=selfhosted
# Alias legacy: SELF_HOSTED=true equivale a DEPLOYMENT_MODE=selfhosted
# SELF_HOSTED=true

# Invoice file storage — local (default) or private Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/files
# Generate with: openssl rand -base64 48. Required for local signed downloads.
STORAGE_SIGNING_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
STORAGE_PRESIGN_TTL=5m
# Optional public API origin for absolute local signed URLs.
# STORAGE_PUBLIC_URL=https://api.example.com
# Legacy PDF/certificate storage path.
STORAGE_PATH=/app/storage/pdfs

# Cloudflare R2 — private bucket when STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=supay-pdfs
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pdfs.supay.bo

# Contingencia dev — permite POST /invoices con issue_date arbitrario para simular offline
# default: true en PILOTO (SIAT_AMBIENTE=2), false en PRODUCCION. Sobrescribe con 1/0.
ALLOW_CUSTOM_ISSUE_DATE=1

# Fase 8 — renovación automática y alertas de certificados
MAINTENANCE_ENABLED=true
CREDENTIAL_RENEWAL_INTERVAL=1h
CERTIFICATE_CHECK_INTERVAL=24h
MAINTENANCE_JOB_TIMEOUT=5m
CUFD_RENEWAL_LEAD=4h
CUIS_RENEWAL_LEAD=720h
# Se usa solo para CUIS legacy o respuestas SIAT sin fecha de vigencia.
CUIS_FALLBACK_VALIDITY=8760h
CERTIFICATE_NOTIFICATION_TIMEOUT=10s
# Fallback global. Por tenant se recomienda enviar certificate_webhook_url al
# registrar la compañía o mediante PATCH /companies/{id}.
# CERTIFICATE_ALERT_WEBHOOK_URL=https://operaciones.example/webhooks/supay

# Fase 9 — outbox + River + protección multi-tenant de llamadas SIAT
EMISSION_QUEUE_ENABLED=true
OUTBOX_DISPATCH_INTERVAL=500ms
OUTBOX_DISPATCH_BATCH_SIZE=100
OUTBOX_LOCK_TIMEOUT=1m
EMISSION_QUEUE_WORKERS=10
EMISSION_MAX_ATTEMPTS=8
EMISSION_JOB_TIMEOUT=2m
EMISSION_SOFT_STOP_TIMEOUT=30s
EMISSION_RETRY_BASE=2s
EMISSION_RETRY_MAX=5m
SIAT_TENANT_RATE_PER_SECOND=2
SIAT_TENANT_RATE_BURST=2
SIAT_CIRCUIT_FAILURE_THRESHOLD=5
SIAT_CIRCUIT_COOLDOWN=30s
