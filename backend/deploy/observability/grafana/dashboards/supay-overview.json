    },
    {
      "id": 2,
      "title": "Emisiones exitosas",
      "type": "stat",
      "targets": [{"expr": "sum(rate(supay_invoice_emissions_total{result=\"success\"}[5m])) / clamp_min(sum(rate(supay_invoice_emissions_total[5m])), 0.000001)", "legendFormat": "éxito", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Latencia p95 de emisión",
      "type": "stat",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(supay_invoice_emission_duration_seconds_bucket[5m])))", "refId": "A"}],
